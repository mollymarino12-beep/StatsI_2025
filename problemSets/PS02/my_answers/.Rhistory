bribe_table <- matrix(
c(14, 6, 7,
7, 7, 1),
nrow = 2,
byrow = TRUE
)
rownames(bribe_table) <- c("Upper class", "Lower class")
bribe_table
row_totals <- rowSums(bribe_table)
col_totals <- colSums(bribe_table)
grand_total <- sum(bribe_table)
expected <- outer(row_totals, col_totals) / grand_total
expected
chi_contrib <- (bribe_table - expected)^2 / expected
chi_contrib
chi_square_stat <- sum(chi_contrib)
chi_square_statcolnames(bribe_table) <- c("Not Stopped", "Bribe requested", "Stopped/given warning")
