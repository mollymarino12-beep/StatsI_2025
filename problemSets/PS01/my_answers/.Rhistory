library(ggplot2)
ggplot() +
geom_point(aes(x = df$Per_Capita_Personal_Income_State,
y = df$Per_Capita_Expenditure_Housing), color = "blue") +
geom_point(aes(x = df$Number_Residents_Financially_Insecure_Per_Hundred_Thousand,
y = df$Per_Capita_Expenditure_Housing), color = "red") +
geom_point(aes(x = df$Number_People_Residing_Urban_Areas_Per_Thousand,
y = df$Per_Capita_Expenditure_Housing), color = "green")
# Reshape to long format
df_long <- df %>%
pivot_longer(
cols = c(Per_Capita_Personal_Income_State,
Number_Residents_Financially_Insecure_Per_Hundred_Thousand,
Number_People_Residing_Urban_Areas_Per_Thousand),
names_to = "Variable",
values_to = "X_value"
)
library(tidyverse)
# Reshape to long format
df_long <- df %>%
pivot_longer(
cols = c(Per_Capita_Personal_Income_State,
Number_Residents_Financially_Insecure_Per_Hundred_Thousand,
Number_People_Residing_Urban_Areas_Per_Thousand),
names_to = "Variable",
values_to = "X_value"
)
# Nice labels
pretty_labels <- c(
Per_Capita_Personal_Income_State = "Per Capita Personal Income",
Number_Residents_Financially_Insecure_Per_Hundred_Thousand = "Financially Insecure Residents (per 100,000)",
Number_People_Residing_Urban_Areas_Per_Thousand = "Urban Residents (per 1,000)"
)
# Plot with legend
ggplot(df_long, aes(x = X_value,
y = Per_Capita_Expenditure_Housing,
color = Variable,
shape = Variable)) +
geom_point(size = 2, alpha = 0.7) +
scale_color_manual(values = c("blue", "red", "green"),
labels = pretty_labels) +
scale_shape_manual(values = c(16, 17, 15),
labels = pretty_labels) +
labs(
title = "Per Capita Housing Assistance vs Predictors",
x = "Predictor Value",
y = "Per Capita Expenditure on Housing Assistance",
color = "Predictor",
shape = "Predictor"
) +
theme_minimal()
